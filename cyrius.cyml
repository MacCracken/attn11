[package]
name = "attn11"
version = "${file:VERSION}"
description = "attn11 — a from-scratch GPT-style transformer, trained, in Cyrius"
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.7.18"
repository = "https://github.com/MacCracken/attn11"

[build]
entry = "src/main.cyr"
test = "src/test.cyr"
output = "build/attn11"

[deps]
stdlib = ["string", "fmt", "alloc", "io", "vec", "str", "syscalls", "assert", "bench", "math", "ganita", "args", "hashmap", "tagged", "fnptr", "mmap", "dynlib", "sakshi", "thread", "sankoch", "mabda"]

# The corpus + tokenizer data layer (byte-level + BPE), extracted from src/train.cyr
# at M1 (was src/tok.cyr). attn11 supplies the consumer symbols the bundle leaves
# unresolved — `puts`/`_putc` (src/tensor.cyr) + `secure_read_file`/`read_stdin`/
# `file_seek` (src/fileio.cyr); `t_alloc`/`t_zero` come from [deps.rosnet] above.
# Pinned to akshara's 0.1.0 release tag (the resolved lib/akshara.cyr is byte-identical
# to the local dist bundle the extraction was validated against).
# `1.0.2` → `1.0.4` (6.6.20 realign): the akshara release built against 6.6.20.
# `1.0.4` → `1.1.0` (6.7.9 realign): the 6.7.9-built release; no source/API change.
# `1.1.0` → `1.1.3` (6.7.18 realign, latest): 1.1.2's hardening sweep — same output on
# valid input; a second `bpe_learn` over an already-BPE store now returns -4 (learn again
# after a fresh `corpus_set`); fatal messages go to stderr with an "akshara:" prefix.
[deps.akshara]
git = "https://github.com/MacCracken/akshara"
tag = "1.1.3"
modules = ["dist/akshara.cyr"]

# M18 (v1.8.x GPU arc) — LANDED in v1.8.0 (X027). mabda is the GPU foundation under
# rosnet's [lib.gpu] profile (dist/rosnet-gpu.cyr, which owns the whole GPU backend
# since 1.10.0 — attn11's own src/gpu.cyr was deleted then); since 1.14.4 mabda is the
# bundled stdlib leaf "mabda" above, not a git dep. The 8 stdlib needs above
# (hashmap/tagged/fnptr/mmap/dynlib/sakshi/thread/sankoch) are mabda's.
# The `--gpu` forward matmul runs on the native-AMD
# f64 SPIR-V path, BIT-EXACT vs the CPU oracle (a --gpu run reproduces the no-flag
# run byte-for-byte). The ~1 MB dist amalgamation (binary ~373 KB → ~1.34 MB) is a
# transient binary-SIZE cost — cyrius lacks `dep-module-call` (slated for 6.2.x,
# slims back with ZERO attn11 change) — NOT a gate; binary size never gated M18.

# Extracted at the v1 freeze: the tensor storage / BLAS-1 / matmul (+ gradient)
# layer -> rosnet; the deterministic statistical PRNG -> tyche. attn11 now
# consumes both and dogfoods them — its own finite-difference grad-checks
# validate rosnet's linear, and a byte-identical training run proves the swap.
# `1.0.1` → `1.1.1` (6.6.20 realign): 1.1.0's portable-log `rng_normal` moves
# 0.011% of x86_64 normal draws by 1–3 ulp (and makes aarch64 match x86_64), so
# weight init — and with it a default training run — is no longer byte-identical
# to the 1.0.1 stream. The frozen 1.x API is unchanged.
# `1.1.1` → `1.2.0` (6.7.9 realign): no source change; tyche's golden stream dump
# is byte-identical across the move.
# `1.2.0` → `1.2.2` (6.7.18 realign, latest): same bits for every reachable state; a
# written `_rng_state` of 0 now steps as 1 instead of hanging `rng_normal` (a checkpoint
# captured from a running stream is never 0).
[deps.tyche]
git = "https://github.com/MacCracken/tyche"
tag = "1.2.2"
modules = ["dist/tyche.cyr"]

# rosnet 1.1.0: the frozen 1.0 surface attn11 already exercised (identical to the 0.2.0
# code) + conv2d/conv1d fwd+bwd (NCHW, per-axis stride/pad, FD-gated) — pulled in for the
# vision lane (src/vision.cyr, the sight proof). The GPU [lib.gpu] profile rides along
# unchanged (dist/rosnet-gpu.cyr leaves mabda's symbols unresolved; the bundled stdlib
# `mabda` leaf supplies them — see the retired [deps.mabda] note below).
#
# `1.1.1` → `1.1.2` (6.6.2 migration): 1.1.1's dist/rosnet-gpu.cyr predates the
# v6.6.0 Result VALUE FORM. It bound `var res = gpu_context_new_native();` (a
# single-value bind of a `: stack` pair — now a hard error) and called the
# `payload()` helper deleted at v6.6.0. 1.1.2 is the migrated release; both
# dist modules are clean of the retired API.
#
# `1.1.2` → `1.1.3` (6.6.20 realign): no source change; the CPU bundle differs
# only in whitespace, and the gpu sidecar now names mabda/math/ganita itself.
# `1.1.3` → `1.2.0` (6.7.9 realign): no source change; both bundles differ only in
# their version line.
# `1.2.0` → `1.4.1` (6.7.18 realign, latest): faster kernels with the SAME bits (rosnet
# ADR 0002 — every optimization keeps each output's sequence of roundings): 1.2.2's packed
# linear/conv rewrite + GPU hardening, 1.3.0's GPU fallback fixes, 1.4.0's tiled GPU
# attention (hd < 128 now runs on device), 1.4.1's AVX2 linear (vmulpd+vaddpd, not FMA).
# The CPU bundle now `include`s lib/simd.cyr itself.
[deps.rosnet]
git = "https://github.com/MacCracken/rosnet"
tag = "1.4.1"
modules = ["dist/rosnet.cyr", "dist/rosnet-gpu.cyr"]

# The transformer FORWARD leaf-op CPU math, extracted to rupantara so there is ONE
# source of truth: attn11 delegates its ln_fwd / gelu_fwd / attn_core_fwd (causal)
# CPU bodies to rupantara's ru_* ops. The GPU (--gpu / --gpu-tc) and bidirectional-
# diffusion (g_bidir) branches stay attn11-local, as does ALL backward. rupantara
# consumes the same rosnet 0.2.0, so the matmul under the delegated forward is
# bit-identical (the parity contract); attn11's full grad-check suite is the live
# parity proof (one binary, no offline compare).
#
# `0.4.2` → `0.4.4` (6.6.20 realign), and the local `path = "../rupantara"`
# override is DROPPED: it was a re-fold-era stopgap (the ru_* rename has long
# since shipped), and it resolved from whatever the sibling worktree held — by
# now rupantara 0.5.3, a 6.7.18-pinned line — so the declared tag was never what
# built locally. The git+tag is now the only source.
# `0.4.4` → `0.5.0` (6.7.9 realign): no change to the forward or the API; the
# bundle differs only in its version line + version constant.
# `0.5.0` → `0.5.3` (6.7.18 realign, latest): hardening (config/token-id validation at
# the model entries, KV-cache bound) and faster attention/embedding; outputs on valid
# input are bit-identical, and the attn11 parity contract is untouched.
[deps.rupantara]
git = "https://github.com/MacCracken/rupantara"
tag = "0.5.3"
modules = ["dist/rupantara.cyr"]

# M18 (the v1.8.x GPU arc): mabda is the GPU *foundation* — device/context init,
# buffers, compute-pipeline + dispatch. attn11 consumes the native-AMD SPIR-V f64
# compute path (proven bit-exact on Cezanne, X025), launcher-free + pure-Cyrius, so
# the binary stays static/no-libc. The tensor kernels are attn11/rosnet's, layered
# ON mabda's primitives (ADR 0016) — mabda is consumed, never modified.
# LANDED for M18 (v1.8.x GPU arc): mabda 3.4.1, the collision-fixed release (X026). The
# ~1 MB dist amalgamation is a transient binary-SIZE cost (cyrius lacks dep-module-call;
# slated for 6.2.x, slims back with zero attn11 change) — NOT a gate on the GPU work.
#
# `3.4.1` → `4.0.7` (2026-07-30): 3.4.1 does not COMPILE on cycc >= 6.5.1. Its
# `gpu_texture_create_cube` dispatched a 4-arg backend filler through `fncall5`
# (`fp` + 5 args); the surplus arg was zero-filled and ignored, so it was latent —
# until 6.5.1 escalated a wrong argument count from warning to hard ERROR. mabda
# corrected it to `fncall4` in **4.0.2**; 4.0.7 is the head of that line. attn11
# never calls the symbol — the whole bundle is dead code here on agnos, and the
# Linux `--gpu` path goes through rosnet's [lib.gpu] profile — but a prepended dep
# module must still type-check, so a build for EITHER target failed on it.
#
# The 3.x → 4.x major is safe for attn11: 4.0.0 ADDS a native NVIDIA backend, and
# 4.0.0/4.0.1/4.0.2 each state no public-API signature change. The 4.0.1 breakage
# is AMD-on-**wgpu** deprecation (warn-and-allow) plus a `deps/wgpu_main.c`
# launcher change for consumers that VENDOR it — attn11 does neither: it rides
# `BACKEND_KIND_AMD`, the native amdgpu DRM path.
#
# `4.0.9` → `4.1.1` (6.6.2 migration): 4.0.9 predates the v6.6.0 Result VALUE
# FORM — `surface_state_acquire` + the seven `gpu_texture_load_*_result` call
# sites single-value-bound a `: stack` pair (now a hard error), and the bundle
# still called the deleted `payload()`. 4.1.1 is migrated. As before, the whole
# bundle is dead code for attn11 (it rides rosnet's [lib.gpu] profile) but a
# prepended dep module must still type-check, so a stale pin fails the build.
#
# 6.6.20 realign — `[deps.mabda]` (git tag 4.1.1) is RETIRED in favour of the
# BUNDLED stdlib leaf: the 6.6.20 snapshot folds mabda 4.1.7 (`lib/mabda.cyr`,
# byte-identical to the 4.1.7 tag's dist/mabda.cyr), so `"mabda"` now sits in
# `[deps] stdlib` above. Keeping both made `cyrius deps` refuse to overwrite the
# stdlib leaf ("declare it in [deps] stdlib OR depend on the package, not
# both") and pulled mabda's git deps samvada/chitra/sakshi transitively for
# nothing (attn11 never reaches the samvada/chitra calls; they are `#ifdef`-
# gated). rosnet 1.1.3's dist/rosnet-gpu.cyr also `include`s lib/mabda.cyr
# itself now. 4.1.5 added the `chrono` leaf (`clock_now_ns`); the bundle
# carries that `include` too. Future mabda moves ride the toolchain pin.

# Sovereign FFT for the HEARING lane's fixed STFT+mel frontend (num_fft — the
# frontend is not trained, no backprop through it). Collision-checked vs the
# full attn11 surface + stdlib modules (comm -12 empty, 2026-07-07).
# target-gated x86-only: hisab's num_fft twiddles call f64_sin/f64_cos, which
# are x86 builtins with no aarch64 polyfill yet (cyrius "needs polyfill" — issue
# docs/development/issues/2026-07-07-cyrius-aarch64-trig-polyfill.md). Dep
# modules auto-prepend on every matching target, so the arch gate must live
# HERE (v6.3.1 `target` key — the reason the pin is >= 6.3.1), paired with the
# `#ifndef CYRIUS_ARCH_AARCH64` around the manual includes in src/tests.
#
# `2.11.1` → `2.11.2` (6.6.2 migration): the 2.11.1 TAG DOES NOT EXIST upstream —
# `git clone --branch 2.11.1` fails "Remote branch not found", so dep resolution
# errored and the build aborted before compiling a single line. 2.11.1 was a real
# release (VERSION 2.11.1 at hisab commit a09d228) but its tag was never pushed /
# was deleted; no tag points at that commit today. 2.11.2 is the next patch,
# a09d228 is its ancestor, and it is what six sibling repos (ghurni, dhvani,
# garjan, prakash, prani, nidhi) already pin. Not a value-form change: hisab's
# dist has zero Result/Option surface — verified by the hearing-lane grad-check
# (23/23), which is the live num_fft exercise.
#
# `2.11.2` → `3.3.7` (6.6.20 realign): the hisab release built against 6.6.20.
# Two changes reach the hearing lane: 3.0.0 made `num_fft` return a
# `Result` (`#must_use`, Ok(0) / Err(HSB_ERR_INVALID_INPUT)), and 3.3.7 reseeds
# its twiddles every 64 steps, so from n = 256 (HEAR_W) the outputs move in
# their last bits. The frontend is fixed (not trained), so FD grad-checks are
# unaffected; the hearing features are not byte-identical to 2.11.2.
#
# `3.3.7` → `3.4.0` (6.7.9 realign): 3.4.0 retires 27 public names for
# `_checked` Result replacements, none of which attn11 calls; `num_fft` (the one
# function the hearing lane uses) is body-identical to 3.3.7.
# `3.4.0` → `3.4.1` (6.7.18 realign, latest): the 3.4.0 findings; `num_fft` only gains an
# `n < 0` → Err guard (no change at n = 256).
[deps.hisab]
git = "https://github.com/MacCracken/hisab"
tag = "3.4.1"
target = "x86_64"
modules = ["dist/hisab.cyr"]
---
